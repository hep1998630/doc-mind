# =============================================================================
# DocMind Configuration
# =============================================================================
# Copy this file to .env and update the values as needed.
# Nested settings use double underscore (__) as delimiter.

# --- General ---
LOG_LEVEL=INFO

# --- Preprocessing ---
PREPROCESSING__ENABLE_DESKEW=true
PREPROCESSING__ENABLE_DENOISE=true
PREPROCESSING__ENABLE_BINARIZE=false
PREPROCESSING__BINARIZE_BLOCK_SIZE=11
PREPROCESSING__DENOISE_KERNEL_SIZE=3

# --- OCR ---
OCR__ENGINE=paddleocr
OCR__LANGUAGES=["ar","en"]
OCR__CONFIDENCE_THRESHOLD=0.5

# --- Layout ---
LAYOUT__MODEL_PATH=./weights/yolo_layout.pt
LAYOUT__CONFIDENCE_THRESHOLD=0.5
# LAYOUT__CATEGORIES_TO_KEEP=["table","text","title","section_header","page_header","page_footer"]

# --- Mapping ---
MAPPING__OVERLAP_THRESHOLD=0.5
MAPPING__USE_CENTER_CONTAINMENT=true

# --- Extraction (Cloud Provider) ---
EXTRACTION__PROVIDER=anthropic
EXTRACTION__API_KEY=your-api-key-here
# EXTRACTION__BASE_URL=
EXTRACTION__MODEL=claude-sonnet-4-20250514
EXTRACTION__TEMPERATURE=0.0
EXTRACTION__MAX_TOKENS=4096

# --- Extraction (Local Model - uncomment to use) ---
# EXTRACTION__PROVIDER=local
# EXTRACTION__BASE_URL=http://localhost:11434/v1
# EXTRACTION__MODEL=llama3
# EXTRACTION__TEMPERATURE=0.0
# EXTRACTION__MAX_TOKENS=4096
