# =============================================================================
# DocMind Configuration
# =============================================================================
# Copy this file to .env and update the values as needed.
# Nested settings use double underscore (__) as delimiter.

# --- General ---
LOG_LEVEL=INFO

# --- Pipeline ---
# Pipeline mode: 'vlm' (recommended) or 'ocr'
PIPELINE_MODE=vlm

# --- Authentication ---
# Comma-separated API keys. Leave empty for open access (dev mode).
API_KEYS=

# --- Preprocessing ---
PREPROCESSING__ENABLE_DESKEW=true
PREPROCESSING__ENABLE_DENOISE=true
PREPROCESSING__ENABLE_BINARIZE=false
PREPROCESSING__BINARIZE_BLOCK_SIZE=11
PREPROCESSING__DENOISE_KERNEL_SIZE=3

# --- OCR (only used when PIPELINE_MODE=ocr) ---
OCR__ENGINE=paddleocr
OCR__LANGUAGES=["ar","en"]
OCR__CONFIDENCE_THRESHOLD=0.5
OCR__DEVICE=gpu:0
# OCR__DETECTION_MODEL=PP-OCRv5_server_det
# OCR__RECOGNITION_MODEL=PP-OCRv5_server_rec

# --- Layout (optional, not used in MVP) ---
LAYOUT__MODEL_PATH=./weights/yolo_layout.pt
LAYOUT__CONFIDENCE_THRESHOLD=0.5

# --- Mapping (optional, not used in MVP) ---
MAPPING__OVERLAP_THRESHOLD=0.5
MAPPING__USE_CENTER_CONTAINMENT=false

# --- Extraction / VLM ---
# Recommended: google/gemini-2.5-flash (best speed/accuracy balance)
EXTRACTION__PROVIDER=openai
EXTRACTION__API_KEY=your-api-key-here
EXTRACTION__BASE_URL=https://openrouter.ai/api/v1
EXTRACTION__MODEL=google/gemini-2.5-flash
EXTRACTION__TEMPERATURE=0.0
EXTRACTION__MAX_TOKENS=4096
EXTRACTION__MAX_IMAGE_LONG_EDGE=1568

# --- Alternative Extraction Configs ---
# Anthropic Claude Opus (best field accuracy):
# EXTRACTION__PROVIDER=anthropic
# EXTRACTION__API_KEY=sk-ant-...
# EXTRACTION__MODEL=claude-opus-4-20250110

# Local model via Ollama:
# EXTRACTION__PROVIDER=local
# EXTRACTION__BASE_URL=http://localhost:11434/v1
# EXTRACTION__MODEL=llama3
